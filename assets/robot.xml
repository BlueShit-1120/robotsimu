<mujoco model="marvin_arm">
  <!-- Exported by MuJoCo URDF parser, then augmented:
       - realistic damping / armature for numerical stability
       - actuators (7 motors)
       - wrist F/T sensor
       - self-collision disabled via contype/conaffinity
       - keyframe for natural "ready" pose
  -->

  <compiler angle="radian" meshdir="meshes"/>

  <!-- ADR-0022: 物理步长。step() 跑 n_sub=round(1ms/timestep) 子步（控制环仍 1kHz）。
       0.5ms（n_sub=2）极限推送经 095137 证伪——力信号无增益、且极硬接触致首触力尖峰
       (5ms 内 2→20N) 力超限 abort。已回退 1ms（n_sub=1=原行为）。子步代码保留备用。 -->
  <option timestep="0.001" gravity="0 0 -9.81" solver="Newton" iterations="50" integrator="implicitfast"/>

  <!-- =====================================================================
       Defaults
       damping / armature: chosen for numerical stability, NOT real-hardware
       values. The sim_bridge PD controller (Kd=50) provides dominant
       velocity damping; model damping just prevents drift.

       Collision layers:
         robot links  contype=2  conaffinity=1  → collide with ground only
         ground       contype=1  conaffinity=3  → collide with robot
         (self-collision fully disabled)
       ===================================================================== -->
  <default>
    <joint damping="5" armature="0.1" frictionloss="0.5"/>
    <geom contype="2" conaffinity="1" condim="4"
          friction="0.8 0.2 0.2" solref="0.02 1"/>
    <motor ctrllimited="true"/>
  </default>

  <!-- =====================================================================
       Assets
       ===================================================================== -->
  <asset>
    <!-- Body prefix meshes (spr_robot_description DVT1, ADR-0027). Shared by both
         arms; visual-only (contype/conaffinity 0 on their geoms below). -->
    <mesh name="base_link"        file="base_link.STL"/>
    <mesh name="torso_lift_link"  file="torso_lift_link.STL"/>
    <mesh name="waist_pitch_link" file="waist_pitch_link.STL"/>
    <mesh name="head_yaw_link"    file="head_yaw_link.STL"/>
    <mesh name="head_pitch_link"  file="head_pitch_link.STL"/>
    <!-- ADR-0027: chassis wheels/steering — VISUAL ONLY (no physics, no joint) -->
    <mesh name="front_left_steering_link"  file="front_left_steering_link.STL"/>
    <mesh name="front_left_wheel_link"     file="front_left_wheel_link.STL"/>
    <mesh name="rear_left_steering_link"   file="rear_left_steering_link.STL"/>
    <mesh name="rear_left_wheel_link"      file="rear_left_wheel_link.STL"/>
    <mesh name="rear_right_steering_link"  file="rear_right_steering_link.STL"/>
    <mesh name="rear_right_wheel_link"     file="rear_right_wheel_link.STL"/>
    <mesh name="front_right_steering_link" file="front_right_steering_link.STL"/>
    <mesh name="front_right_wheel_link"    file="front_right_wheel_link.STL"/>
    <mesh name="Base_L"  file="Base_L.STL"/>
    <mesh name="Link1_L" file="Link1_L.STL"/>
    <mesh name="Link2_L" file="Link2_L.STL"/>
    <mesh name="Link3_L" file="Link3_L.STL"/>
    <mesh name="Link4_L" file="Link4_L.STL"/>
    <mesh name="Link5_L" file="Link5_L.STL"/>
    <mesh name="Link6_L" file="Link6_L.STL"/>
    <mesh name="Link7_L" file="Link7_L.STL"/>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.2 0.2 0.2" rgb2="0.6 0.6 0.6" width="100" height="100"/>
    <material name="grid_mat" texture="grid" texrepeat="4 4" reflectance="0.1"/>
  </asset>

  <!-- =====================================================================
       World
       ===================================================================== -->
  <worldbody>
    <light name="top"  pos="0 0 3" dir="0 0 -1" directional="true"
           diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <light name="side" pos="2 -2 2" dir="-1 1 -1" directional="true"
           diffuse="0.4 0.4 0.4"/>

    <!-- ground: layer 0, collides with robot (layer 1) -->
    <geom name="ground" type="plane" size="2 2 0.01"
          contype="1" conaffinity="3" condim="3"
          material="grid_mat" rgba="0.8 0.8 0.8 1"/>

    <!-- base_link: freejoint root (ADR-0027 approach-2 body import). The whole
         upper body hangs off it; the base_pose command welds this to base_target.
         torso_lift/waist_pitch are baked as FIXED bodies (lift=0, pitch=0) so the
         only non-freejoint joints remain the 7 arm joints (qpos_offset_=7). Body
         meshes are VISUAL-ONLY (contype=0 conaffinity=0). -->
    <body name="base_link" pos="0 0 0">
      <freejoint name="base_freejoint"/>
      <geom type="mesh" mesh="base_link" rgba="0.843 0.859 0.875 1" contype="0" conaffinity="0"/>

      <!-- ADR-0027: chassis wheels/steering — static VISUAL-ONLY (no joint, no physics,
           steering/wheel angles baked at 0). Purely for display completeness. -->
      <body name="front_left_steering_link" pos="0.25 0.22 0.2062" quat="0.707105 0 0 -0.707108">
        <geom type="mesh" mesh="front_left_steering_link" rgba="0.337 0.357 0.388 1" contype="0" conaffinity="0"/>
        <body name="front_left_wheel_link" pos="-0.0349 4.0149e-05 -0.13113" quat="-0.499998 0.5 0.500002 -0.5">
          <geom type="mesh" mesh="front_left_wheel_link" rgba="0.141 0.149 0.165 1" contype="0" conaffinity="0"/>
        </body>
      </body>
      <body name="rear_left_steering_link" pos="-0.25 0.22 0.2062" quat="0.707105 0 0 -0.707108">
        <geom type="mesh" mesh="rear_left_steering_link" rgba="0.337 0.357 0.388 1" contype="0" conaffinity="0"/>
        <body name="rear_left_wheel_link" pos="-0.035 -4.016e-05 -0.13133" quat="-0.499998 0.5 0.500002 -0.5">
          <geom type="mesh" mesh="rear_left_wheel_link" rgba="0.141 0.149 0.165 1" contype="0" conaffinity="0"/>
        </body>
      </body>
      <body name="rear_right_steering_link" pos="-0.25 -0.22 0.2062" quat="0.707105 0 0 -0.707108">
        <geom type="mesh" mesh="rear_right_steering_link" rgba="0.337 0.357 0.388 1" contype="0" conaffinity="0"/>
        <body name="rear_right_wheel_link" pos="0.0349 -4.0149e-05 -0.13113" quat="-0.499337 0.50076 0.49924 -0.50066">
          <geom type="mesh" mesh="rear_right_wheel_link" rgba="0.141 0.149 0.165 1" contype="0" conaffinity="0"/>
        </body>
      </body>
      <body name="front_right_steering_link" pos="0.25 -0.22 0.2062" quat="0.707105 0 0 -0.707108">
        <geom type="mesh" mesh="front_right_steering_link" rgba="0.337 0.357 0.388 1" contype="0" conaffinity="0"/>
        <body name="front_right_wheel_link" pos="0.035 4.016e-05 -0.13133" quat="0.500705 0.499192 -0.500809 -0.499292">
          <geom type="mesh" mesh="front_right_wheel_link" rgba="0.141 0.149 0.165 1" contype="0" conaffinity="0"/>
        </body>
      </body>

      <!-- torso_lift (prismatic z, baked lift=0) -> waist_pitch (revolute, baked pitch=0) -->
      <body name="torso_lift_link" pos="0.0515 0 0.5162">
        <geom type="mesh" mesh="torso_lift_link" rgba="0.945 0.953 0.961 1" contype="0" conaffinity="0"/>
        <body name="waist_pitch_link" pos="0.15075 0 0" quat="0.707105 -0.707108 0 0">
          <geom type="mesh" mesh="waist_pitch_link" rgba="0.945 0.953 0.961 1" contype="0" conaffinity="0"/>

          <!-- head chain: visual only, no arm joints -->
          <body name="head_yaw_link" pos="0 -0.58 0" quat="0.707105 0.707108 0 0">
            <geom type="mesh" mesh="head_yaw_link" rgba="0.102 0.11 0.125 1" contype="0" conaffinity="0"/>
            <body name="head_pitch_link" pos="0 0 0.0305" quat="0.707105 -0.707108 0.000146 -0.000146">
              <geom type="mesh" mesh="head_pitch_link" rgba="0.102 0.11 0.125 1" contype="0" conaffinity="0"/>
            </body>
          </body>

          <!-- arm-base wrapper: baked mount under waist; holds the arm chain verbatim
               (left mount here; gen_arm_mjcf swaps to the right mount for robot_right.xml) -->
          <body name="Base_L" pos="0 -0.3525 0.0355">
            <geom type="mesh" mesh="Base_L" rgba="0.906 0.918 0.929 1"/>

    <body name="Link1_L" pos="0 0 0.1745">
      <inertial pos="1.923e-05 0.00600811 -0.0314838"
                quat="0.70857 0.0377876 -0.038303 0.703586"
                mass="2.0407" diaginertia="0.00552621 0.0050956 0.00192814"/>
      <joint name="Joint1_L" axis="0 0 1" range="-3.1067 3.1067"
             actuatorfrcrange="-108 108"/>
      <geom type="mesh" mesh="Link1_L" rgba="0.906 0.918 0.929 1"/>

      <body name="Link2_L" quat="0.707105 0.707108 0 0">
        <inertial pos="-7.03e-06 0.0554202 0.010995"
                  quat="0.641173 0.767392 -0.00214053 0.00133687"
                  mass="1.9432" diaginertia="0.0103546 0.00975036 0.00294632"/>
        <joint name="Joint2_L" axis="0 0 1" range="-2.0944 2.0944"
               actuatorfrcrange="-108 108"/>
        <geom type="mesh" mesh="Link2_L" rgba="0.906 0.918 0.929 1"/>

        <body name="Link3_L" pos="0 0.287 0" quat="0.707105 -0.707108 0 0">
          <inertial pos="0.00874109 0.00190429 -0.0521264"
                    quat="0.74724 -0.000471318 -0.00119608 0.664553"
                    mass="1.6913" diaginertia="0.0116265 0.0110956 0.00177967"/>
          <joint name="Joint3_L" axis="0 0 1" range="-3.1067 3.1067"
                 actuatorfrcrange="-66 66"/>
          <geom type="mesh" mesh="Link3_L" rgba="0.906 0.918 0.929 1"/>

          <body name="Link4_L" pos="0.018 0 0"
                quat="-2.59734e-06 2.59735e-06 -0.707108 0.707105">
            <inertial pos="0.00862861 -0.045831 0.00996355"
                      quat="0.73751 0.621496 0.0962516 -0.246083"
                      mass="1.5216" diaginertia="0.0055167 0.00490898 0.00182653"/>
            <joint name="Joint4_L" axis="0 0 1" range="-2.5307 1.0472"
                   actuatorfrcrange="-66 66"/>
            <geom type="mesh" mesh="Link4_L" rgba="0.906 0.918 0.929 1"/>

            <body name="Link5_L" pos="0.018 -0.314 0"
                  quat="-2.59734e-06 2.59735e-06 -0.707108 0.707105">
              <inertial pos="-0.000371 -0.00123806 -0.114953"
                        quat="0.999205 -0.00186779 0.00612471 -0.0393567"
                        mass="2.0099" diaginertia="0.00580518 0.00534676 0.0021605"/>
              <joint name="Joint5_L" axis="0 0 1" range="-3.1067 3.1067"
                     actuatorfrcrange="-18 18"/>
              <geom type="mesh" mesh="Link5_L" rgba="0.906 0.918 0.929 1"/>

              <body name="Link6_L" quat="0.499998 0.5 -0.5 0.500002">
                <inertial pos="0.00028419 0.00512339 -0.00013941"
                          quat="0.714651 -0.0162813 -0.00166999 0.699289"
                          mass="0.690234" diaginertia="0.000496136 0.00041496 0.000384083"/>
                <joint name="Joint6_L" axis="0 0 1" range="-1.0472 1.0472"
                       actuatorfrcrange="-18 18"/>
                <geom type="mesh" mesh="Link6_L" rgba="0.906 0.918 0.929 1"/>

                <body name="Link7_L" quat="0.499998 0.5 -0.5 0.500002">
                  <inertial pos="-9.108e-05 -0.0315325 0.00889371"
                            quat="0.826465 0.562966 -0.000603543 0.00495484"
                            mass="0.686062" diaginertia="0.00155072 0.00134736 0.000711008"/>
                  <joint name="Joint7_L" axis="0 0 1" range="-1.5708 1.5708"
                         actuatorfrcrange="-18 18"/>
                  <geom type="mesh" mesh="Link7_L" rgba="0.906 0.918 0.929 1"/>
                  <!-- F/T sensor site at wrist (end-effector body).
                       quat (wxyz) [0.5, 0.5, -0.5, 0.5] ≡ Rx(+90°)·Rz(+90°)
                       (own-Z). pos [0, -0.042, 0] sits 42 mm along body -Y.
                       2026-07-09: added the Rz(+90°) about own Z on top of the
                       ADR-0009 Rx(+90°) vendor rotation. The bare Rx(+90°) put
                       the sim F/T frame 90° about Z off from what realman's
                       getRef_FixedForce reconstructs (recorded TCP ⊗
                       T_sensor_to_flange=Rz0°+38mm). native-as-signal
                       calibration exposed it: force residual 5.98 N (|G|=8.6);
                       with this Rz(+90°) the reported force becomes Rz(-90°)·F,
                       and realman's fit drops to 0.0009 N with |G|=11.635 N
                       (exact payload weight). Verified against the recorded
                       left_arm calibration sweep + a MuJoCo site-rotation probe.
                       Supersedes the ADR-0009 orientation for the left arm;
                       ADR update pending. See project_ft_native_as_signal. -->
                  <site name="wrist_ft_site" pos="0 -0.042 0"
                        quat="0.5 0.5 -0.5 0.5"
                        size="0.015" rgba="1 0.2 0.2 0.8"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
          </body><!-- /Base_L arm base -->
        </body><!-- /waist_pitch_link -->
      </body><!-- /torso_lift_link -->
    </body><!-- /base_link -->

    <!-- base_target: mocap body the base_link freejoint is welded to (issue 11 /
         ADR-0020). Holding the base via a stiff weld to this kinematic target —
         instead of hard-resetting qpos[0:7]/qvel[0:6] every step — removes the
         per-step base disturbance that lagged the arm PD ~0.3deg in free motion
         (20x the real near-ideal inner loop). mujoco_env_control drives
         mocap_pos/quat to base_qpos_ each step, so base_movable is preserved;
         the stiff solref keeps static sag under the arm weight < 0.01 mm. -->
    <body name="base_target" mocap="true" pos="0 0 0" quat="1 0 0 0"/>
  </worldbody>

  <!-- Weld the freejoint base to the base_target mocap body (issue 11 / ADR-0020).
       relpose identity = the two bodies coincide at the mocap pose; the stiff
       solref gives negligible sag while staying a proper constraint (solved with
       the arm dynamics, unlike the old per-step kinematic reset). -->
  <equality>
    <weld name="base_weld" body1="base_link" body2="base_target"
          relpose="0 0 0 1 0 0 0" solref="0.002 1"/>
  </equality>

  <!-- =====================================================================
       Actuators  (torque-controlled motors, clipped to hardware limits)
       ===================================================================== -->
  <actuator>
    <motor name="act_J1" joint="Joint1_L" ctrlrange="-108 108" gear="1"/>
    <motor name="act_J2" joint="Joint2_L" ctrlrange="-108 108" gear="1"/>
    <motor name="act_J3" joint="Joint3_L" ctrlrange="-66  66"  gear="1"/>
    <motor name="act_J4" joint="Joint4_L" ctrlrange="-66  66"  gear="1"/>
    <motor name="act_J5" joint="Joint5_L" ctrlrange="-18  18"  gear="1"/>
    <motor name="act_J6" joint="Joint6_L" ctrlrange="-18  18"  gear="1"/>
    <motor name="act_J7" joint="Joint7_L" ctrlrange="-18  18"  gear="1"/>
  </actuator>

  <!-- =====================================================================
       Sensors
       wrist_ft_force / wrist_ft_torque → sim_bridge → actual_force6d
       ===================================================================== -->
  <sensor>
    <force  name="wrist_ft_force"  site="wrist_ft_site"/>
    <torque name="wrist_ft_torque" site="wrist_ft_site"/>
  </sensor>

  <!-- =====================================================================
       Keyframe: natural "ready" pose (arm extended forward at waist height)
       ===================================================================== -->
  <keyframe>
    <key name="ready" qpos="0 0 0 1 0 0 0  2.12878 1.37377 -1.167877 -1.964821 0.394652 -0.4735 0.2633"/>
  </keyframe>

</mujoco>
